\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Quantitative comparison on PROMISE12. Values are reported as mean $\pm $ standard deviation. Gray cells indicate data-leakage cases. Best valid scores, excluding leakage cases and the SAM3-Full upper bound, are in bold; second-best scores are underlined.}}{11}{}\protected@file@percent }
\newlabel{tab:main_results_promise12}{{4}{11}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Per-case DSC distributions on ACDC, BTCV\_cervix, and PROMISE12. Each point corresponds to one test case, and boxes summarize the interquartile range. SAM3-Scribble shows higher and more stable DSC distributions than the static scribble-supervised baselines on ACDC and PROMISE12, while BTCV\_cervix shows positive but less statistically stable differences due to its smaller test set.}}{12}{}\protected@file@percent }
\newlabel{fig:per_case_dsc_distribution}{{3}{12}}
